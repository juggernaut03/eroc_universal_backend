# --- Server ---
PORT=5001
NODE_ENV=development
CLIENT_URL=*
# This server's own publicly-reachable base URL, no trailing slash. Used to
# tell external systems where to call back (currently: SHALVI PICKER status
# webhooks — see utils/pickerIntegration.js).
PUBLIC_API_BASE_URL=
JWT_SECRET=change-me
# Access token lifetime. Kept short because a refresh token now carries the
# session — an intercepted access token is worth only this long.
JWT_EXPIRE=7d
# Refresh token lifetime, in days. This is the real session length: the app
# renews the access token silently for as long as this lasts.
JWT_REFRESH_EXPIRE_DAYS=90

# How long a just-rotated refresh token keeps working, in ms.
# Covers the gap between the server committing a rotation and the client
# storing the pair it was sent — a window the Razorpay checkout widens, since
# it backgrounds the app for as long as a bank OTP takes. Without it, a dropped
# response left the device holding a token the server had already destroyed and
# the shopper was silently signed out.
JWT_REFRESH_GRACE_MS=60000

# How long spent refresh entries are kept after rotation, in ms. Reuse after
# the grace window revokes every session on the account, so entries must
# outlive the grace period to stay recognisable as reuse.
JWT_REFRESH_SUPERSEDED_RETENTION_MS=86400000
# The admin panel does not implement refresh yet, so its access token keeps the
# long lifetime it always had. Shorten this once the panel adopts refresh.
ADMIN_ACCESS_TOKEN_TTL=30d

# --- MongoDB (multi-tenant) ---
# Single cluster/server URI. Do NOT include a database name — the app selects
# the control DB and per-tenant DBs itself via useDb().
MONGODB_URI=mongodb://127.0.0.1:27017
# Control DB holding the `projects` tenant registry
CONTROL_DB_NAME=Universal_Control
# Fallback tenant for requests without a project code (transition period) and
# for scripts/socket auth running outside a request context
DEFAULT_PROJECT_CODE=RET5677
DEFAULT_DB_NAME=Pagariya_DB

# --- Rate limiting ---
RATE_LIMIT_SKIP_IPS=

# --- Errors ---
# Return error stacks and raw 5xx messages to API clients. Leave unset in any
# deployed environment — this is NOT inferred from NODE_ENV, because the
# deployed servers run with NODE_ENV=development.
EXPOSE_ERROR_DETAIL=false

# --- SMS ---
# The message sender name is taken per-tenant from the project registry
# (config.app_name); SMS_CLIENT_NAME is only the fallback.
SMS_BASE_URL=
SMS_USER_ID=
SMS_PASSWORD=
SMS_SENDER_ID=
SMS_CLIENT_NAME=

# Fixed-OTP escape hatch for local dev and CI. When enabled, SMS_TEST_OTP
# authenticates ANY mobile number without an SMS round trip. BOTH variables are
# required to switch it on, and it must never be enabled on a deployment that
# real customers can reach.
SMS_ALLOW_TEST_OTP=false
SMS_TEST_OTP=

# --- Razorpay (default tenant; per-tenant keys live in the project registry) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Firebase (push notifications) ---
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# --- Cloudinary (media) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Payments ---
# Razorpay credentials belong to the TENANT registry (admin panel →
# Integrations), not here. These are a fallback for single-tenant and local
# installs only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Allow a tenant with no Razorpay pair of its own to use the platform keys
# above. Leave false on anything serving more than one client: under the
# fallback a client's customers pay into the PLATFORM's merchant account, and
# nothing downstream can detect it.
ALLOW_PLATFORM_RAZORPAY_FALLBACK=false
